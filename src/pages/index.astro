    transform 0.2s ease,
    color 0.2s ease;
}

.profile-link:hover strong {
  color: var(--blue);
}

.profile-link:hover .profile-link-arrow {
  transform: translate(2px, -2px);
}

.profile-link:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 5px;
}

.leadership-path {
  display: grid;
  align-items: start;
  margin-top: 64px;
