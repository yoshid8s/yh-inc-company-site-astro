}

.leadership-path > div:not(.path-arrow) {
  min-width: 0;
}

.leadership-path span {
  display: block;
  margin-bottom: 14px;
  color: var(--blue);
  font-family: Georgia, serif;
  font-size: 0.8rem;
  font-weight: 700;
}

.leadership-path strong {
  display: block;
  margin-bottom: 10px;
  color: var(--navy);
  font-family: Georgia, serif;
  font-size: 1.25rem;
  line-height: 1.2;
}

.leadership-path p {
  margin: 0;
  color: #667985;
  font-size: 0.88rem;
}

.path-arrow {
  padding-top: 36px;
  color: #8bb7c7;
  font-family: Georgia, serif;
  font-size: 1.6rem;
}

.leadership-statement {
  margin-top: 70px;
  text-align: center;
}

.leadership-statement span {
  display: block;
  margin-bottom: 10px;
  color: var(--blue);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.leadership-statement p {
  margin-bottom: 4px;
  color: #667985;
}

.leadership-statement strong {
  color: var(--navy);
  font-family: Georgia, serif;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  line-height: 1.3;
}

/* 08 Contact & Collaboration */

.contact-section {
  position: relative;
  overflow: hidden;
  color: #fff;
  background:
    radial-gradient(
      circle at 78% 45%,
      rgb(40 142 171 / 28%),
      transparent 30%
    ),
    var(--navy);
  border-bottom: 0;
}

.contact-section::before {
  position: absolute;
  top: 50%;
  right: 8%;
  width: 360px;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgb(159 197 213 / 45%),
    transparent
  );
  content: "";
}

.contact-section::after {
  position: absolute;
  top: calc(50% - 180px);
  right: calc(8% + 180px);
  width: 1px;
  height: 360px;
  background: linear-gradient(
    180deg,
    transparent,
    rgb(159 197 213 / 45%),
    transparent
  );
  content: "";
}

.contact-section .container {
  position: relative;
  z-index: 1;
}

.contact-section h2 {
  color: #fff;
}

.contact-layout {
  display: grid;
  align-items: start;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 90px;
}

.contact-main .section-title {
  max-width: 760px;
  margin-bottom: 30px;
}

.contact-lead {
  max-width: 700px;
  margin: 0;
  color: #d9eaf1;
  font-size: 1.1rem;
}

.contact-invitation {
  padding: 38px 0 0 36px;
  border-left: 1px solid rgb(255 255 255 / 22%);
}

.contact-label {
  display: block;
  margin-bottom: 18px;
  color: #9fc5d5;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.contact-invitation p {
  color: #d9eaf1;
}

.contact-invitation strong {
  color: #fff;
}

.contact-cta {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin-top: 34px;
  padding: 18px 22px;
  color: var(--navy);
  background: #fff;
  border: 1px solid #fff;
  border-radius: 4px;
  font-weight: 700;
  text-decoration: none;
  transition:
    background 180ms ease,
    color 180ms ease;
}

.contact-cta span:last-child {
  font-family: Georgia, serif;
  font-size: 1.3rem;
}

.contact-cta:hover {
  color: #fff;
  background: transparent;
}

.contact-principle {
  margin-top: 82px;
  padding-top: 34px;
  border-top: 1px solid rgb(255 255 255 / 18%);
}

.contact-principle > span {
  display: block;
  margin-bottom: 18px;
  color: #9fc5d5;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.contact-equation {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 18px;
}

.contact-equation strong {
  color: #fff;
  font-family: Georgia, serif;
  font-size: clamp(1.4rem, 2.5vw, 2rem);
}

.contact-equation span {
  color: #78b7cd;
  font-family: Georgia, serif;
  font-size: 1.7rem;
}

.contact-cta-label {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.github-icon {
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
}

      /* Footer */

      footer {
        padding: 34px 0;
        font-size: 0.85rem;
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

@media (min-width: 801px) and (max-width: 1000px) {
  .belief-layout {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .belief-intro {
    max-width: 680px;
  }

  .integrity-diagram {
    width: min(100%, 620px);
    margin-inline: auto;
  }
}

