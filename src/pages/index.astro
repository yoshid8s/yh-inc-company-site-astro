---
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Y&H Inc. | Brand Integrity by Design</title>

    <meta
      name="description"
      content="Y&H explores Brand Integrity through Behavioral Integrity, Data Integrity, human-centered advertising, and emerging agentic advertising ecosystems."
    />

    <link rel="icon" type="image/svg+xml" href="/yh-logo.svg" />

    <link rel="canonical" href="https://yh-inc.jp/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Y&H Inc." />
    <meta property="og:title" content="Y&H Inc. | Brand Integrity by Design" />
    <meta
      property="og:description"
      content="Exploring Behavioral Integrity, Data Integrity, human-centered advertising, and the future of agentic advertising."
    />
    <meta property="og:url" content="https://yh-inc.jp/" />

    <meta
      property="og:image"
      content="https://yh-inc.jp/images/og-brand-integrity.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Y&H Inc. — Brand Integrity by Design"
    />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Y&H Inc. | Brand Integrity by Design" />
    <meta
      name="twitter:description"
      content="Exploring Behavioral Integrity, Data Integrity, human-centered advertising, and the future of agentic advertising."
    />
    <meta
      name="twitter:image"
      content="https://yh-inc.jp/images/og-brand-integrity.png"
    />
    <meta
      name="twitter:image:alt"
      content="Y&H Inc. — Brand Integrity by Design"
    />

    <style is:global>
      :root {
        --navy: #0b3150;
        --blue: #0d678a;
        --blue-light: #eaf5f8;
        --green-light: #eef8f2;
        --text: #173248;
        --muted: #667985;
        --line: #d9e3e8;
        --bg: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      section[id] {
        scroll-margin-top: 100px;
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--bg);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        line-height: 1.65;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1,
      h2,
      h3 {
        color: var(--navy);
        font-family:
          Georgia,
          "Times New Roman",
          serif;
        line-height: 1.08;
      }

      a {
        color: inherit;
      }

      .container {
        width: min(1180px, calc(100% - 48px));
        margin-inline: auto;
      }

      .eyebrow {
        margin-bottom: 12px;
        color: var(--blue);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .section {
        padding: 96px 0;
        border-bottom: 1px solid var(--line);
      }

      .section-title {
        max-width: 760px;
        margin-bottom: 32px;
        font-size: clamp(2.2rem, 5vw, 4rem);
      }

      .lead {
        max-width: 760px;
        color: #455d6e;
        font-size: 1.15rem;
      }

      /* Header */

      header {
        position: sticky;
        z-index: 10;
        top: 0;
        background: rgb(255 255 255 / 92%);
        border-bottom: 1px solid rgb(217 227 232 / 80%);
        backdrop-filter: blur(14px);
      }

      .header-inner {
        display: flex;
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
      }

      .logo {
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: 1.8rem;
        font-weight: 700;
        text-decoration: none;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 26px;
        font-size: 0.9rem;
      }

      nav a {
        text-decoration: none;
      }

      .contact-button {
        padding: 10px 22px;
        color: #fff;
        background: var(--blue);
        border-radius: 999px;
      }

      /* Hero */

      .hero {
        position: relative;
        display: flex;
        min-height: calc(100vh - 72px);
        align-items: center;
        overflow: hidden;
        background:
          radial-gradient(
            circle at 72% 42%,
            rgb(169 218 232 / 30%),
            transparent 28%
          ),
          linear-gradient(
            135deg,
            #ffffff 0%,
            #f5fbfd 48%,
            #e7f4f8 100%
          );
      }

      .hero::after {
        position: absolute;
        inset: auto 0 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgb(13 103 138 / 30%),
          transparent
        );
        content: "";
      }

      .hero-inner {
        position: relative;
        z-index: 2;
        padding: 100px 0;
      }

      .integrity-mark {
        position: absolute;
        z-index: 1;
        top: 50%;
        left: 76%;
        width: 420px;
        height: 420px;
        transform: translate(-50%, -50%);
        opacity: 0.78;
      }

      .integrity-axis {
        position: absolute;
        display: block;
        border-radius: 999px;
      }

      .integrity-axis-v {
        top: 5%;
        bottom: 5%;
        left: 50%;
        width: 2px;
        transform: translateX(-50%);
        background: linear-gradient(
          180deg,
          transparent,
          rgb(13 103 138 / 25%),
          rgb(13 103 138 / 80%),
          rgb(13 103 138 / 25%),
          transparent
        );
      }

      .integrity-axis-h {
        top: 50%;
        right: 5%;
        left: 5%;
        height: 2px;
        transform: translateY(-50%);
        background: linear-gradient(
          90deg,
          transparent,
          rgb(13 103 138 / 25%),
          rgb(13 103 138 / 80%),
          rgb(13 103 138 / 25%),
          transparent
        );
      }

      .integrity-core {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 18px;
        height: 18px;
        transform: translate(-50%, -50%);
        background: #fff;
        border: 2px solid rgb(13 103 138 / 75%);
        border-radius: 50%;
        box-shadow:
          0 0 0 12px rgb(13 103 138 / 5%),
          0 0 40px 18px rgb(78 181 207 / 18%);
      }

      .hero h1 {
        max-width: 960px;
        margin-bottom: 24px;
        font-size: clamp(3.2rem, 7vw, 6.3rem);
        letter-spacing: -0.035em;
      }

      .hero-subtitle {
        margin-bottom: 22px;
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: clamp(1.4rem, 3vw, 2rem);
      }

      .hero-copy {
        max-width: 780px;
        color: #455d6e;
        font-size: 1.1rem;
      }

      .metrics {
        display: flex;
        width: fit-content;
        margin-top: 42px;
        overflow: hidden;
        background: rgb(255 255 255 / 85%);
        border: 1px solid #b8ccd6;
        border-radius: 4px;
      }

      .metric {
        min-width: 170px;
        padding: 18px 26px;
        border-right: 1px solid var(--line);
      }

      .metric:last-child {
        border-right: 0;
      }

      .metric-label {
        font-family: Georgia, serif;
        font-size: 0.85rem;
      }

      .metric-value {
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: 2.4rem;
        font-weight: 700;
        line-height: 1.1;
      }

      /* 01 Problem */

      .problem-grid {
        display: grid;
        margin-top: 54px;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }

      .card {
        padding: 28px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
      }

      .card h3 {
        font-size: 1.55rem;
      }

      /* 02 Belief */

      .belief {
        position: relative;
        overflow: hidden;
        color: #fff;
        background:
          radial-gradient(
            circle at 68% 48%,
            rgb(35 131 162 / 34%),
            transparent 28%
          ),
          var(--navy);
      }

      .belief h2,
      .belief h3 {
        color: #fff;
      }

      .belief .lead {
        color: #d9eaf1;
      }

      .belief-layout {
        display: grid;
        align-items: center;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 80px;
      }

      .belief-intro .section-title {
        margin-bottom: 28px;
      }

      .integrity-diagram {
        position: relative;
        width: min(100%, 620px);
        height: 410px;
        margin-inline: auto;
      }

      .integrity-circle {
        position: absolute;
        top: 20px;
        display: grid;
        width: 310px;
        height: 310px;
        place-items: center;
        border: 1px solid rgb(255 255 255 / 70%);
        border-radius: 50%;
        text-align: center;
      }

      .integrity-circle.behavioral {
        left: 35px;
        background: rgb(255 255 255 / 3%);
      }

      .integrity-circle.data-circle {
        right: 35px;
        background: rgb(47 162 188 / 7%);
      }

      .integrity-circle h3 {
        margin-bottom: 10px;
        font-size: 1.75rem;
      }

      .integrity-circle p {
        margin: 0;
        color: #c8dce6;
        font-size: 0.92rem;
      }

      .brand-result {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        text-align: center;
      }

      .brand-result::before {
        display: block;
        width: 1px;
        height: 42px;
        margin: 0 auto 12px;
        background: linear-gradient(
          to bottom,
          rgb(255 255 255 / 70%),
          rgb(255 255 255 / 15%)
        );
        content: "";
      }

      .brand-result span {
        display: block;
        margin-bottom: 2px;
        color: #9fc5d5;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .brand-result strong {
        color: #fff;
        font-family: Georgia, serif;
        font-size: 1.8rem;
      }

      .integrity-principle {
        display: grid;
        align-items: center;
        margin-top: 70px;
        padding-top: 36px;
        border-top: 1px solid rgb(255 255 255 / 18%);
        grid-template-columns: 1fr auto 1fr auto 1fr;
        gap: 28px;
      }

      .integrity-principle > div:not(.plus, .equals) {
        min-width: 0;
      }

      .integrity-principle span {
        display: block;
        margin-bottom: 8px;
        color: #9fc5d5;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .integrity-principle strong {
        display: block;
        color: #fff;
        font-family: Georgia, serif;
        font-size: 1.25rem;
        line-height: 1.3;
      }

      .integrity-principle .plus,
      .integrity-principle .equals {
        color: #78b7cd;
        font-family: Georgia, serif;
        font-size: 2rem;
      }

      .integrity-principle .brand strong {
        font-size: 1.55rem;
      }

      /* 03 Brand Integrity Index */

      .index-section {
        background: #fff;
      }

      .index-heading {
        display: grid;
        align-items: end;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        margin-bottom: 64px;
      }

      .index-heading .section-title {
        margin-bottom: 0;
      }

      .index-intro {
        max-width: 580px;
        margin: 0;
        color: #536a79;
        font-size: 1.08rem;
      }

      .index-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }

      .index-column {
        padding: 42px;
        border-radius: 12px;
      }

      .behavioral-index {
        background: #edf7fb;
      }

      .data-index {
        background: #f1f8f3;
      }

      .index-column-heading {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        padding-bottom: 28px;
        border-bottom: 1px solid rgb(11 49 80 / 12%);
      }

      .index-number {
        color: var(--blue);
        font-family: Georgia, serif;
        font-size: 1.2rem;
        font-weight: 700;
      }

      .index-type {
        margin-bottom: 6px;
        color: var(--blue);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .index-column-heading h3 {
        margin: 0;
        font-size: 1.7rem;
      }

      .index-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .index-list li {
        display: grid;
        grid-template-columns: 38px 1fr;
        gap: 12px;
        padding: 25px 0;
        border-bottom: 1px solid rgb(11 49 80 / 10%);
      }

      .item-number {
        padding-top: 2px;
        color: var(--blue);
        font-family: Georgia, serif;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .index-list strong {
        display: block;
        margin-bottom: 6px;
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: 1.2rem;
      }

      .index-list p {
        margin: 0;
        color: #526978;
        font-size: 0.94rem;
      }

      .index-note {
        margin: 28px 0 0;
        color: #526978;
        font-size: 0.9rem;
        font-style: italic;
      }

      .technology-note {
        margin-top: 30px;
        padding: 24px;
        background: rgb(255 255 255 / 65%);
        border: 1px solid rgb(11 49 80 / 10%);
        border-radius: 8px;
      }

      .technology-note span {
        display: block;
        margin-bottom: 10px;
        color: var(--blue);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .technology-note p {
        margin: 0;
        color: #526978;
        font-size: 0.92rem;
      }

      .index-conclusion {
        margin-top: 52px;
        text-align: center;
      }

      .index-conclusion p {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .index-conclusion strong {
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: clamp(2rem, 4vw, 3rem);
      }

      /* 04 Advertising Model */

      .advertising-model {
        overflow: hidden;
        background: linear-gradient(180deg, #fff 0%, #f7fbfc 100%);
      }

      .model-heading {
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px;
        margin-bottom: 64px;
      }

      .model-heading .section-title {
        margin-bottom: 0;
      }

      .model-title {
        display: flex;
        align-items: baseline;
        gap: 0.18em;
        max-width: none;
        white-space: nowrap;
      }

      .model-times {
        color: var(--blue);
        font-weight: 400;
      }

      .model-message {
        max-width: 720px;
        padding-left: 26px;
        border-left: 1px solid #a9c6d3;
      }

      .model-message p:last-child {
        margin: 0;
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: 1.45rem;
        line-height: 1.4;
      }

      .model-kicker {
        margin-bottom: 8px;
        color: var(--blue);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .one-page-visual {
        max-width: 940px;
        margin: 0 auto 72px;
      }

      .page-frame {
        overflow: hidden;
        background: #fff;
        border: 1px solid #b9ced8;
        border-radius: 12px;
        box-shadow: 0 24px 70px rgb(11 49 80 / 8%);
      }

      .page-browser {
        display: flex;
        align-items: center;
        height: 38px;
        padding: 0 15px;
        gap: 6px;
        background: #f2f6f8;
        border-bottom: 1px solid #dce6ea;
      }

      .page-browser span {
        width: 7px;
        height: 7px;
        background: #b7c9d1;
        border-radius: 50%;
      }

      .page-content {
        display: grid;
        min-height: 350px;
        grid-template-columns: 1.45fr 0.55fr;
      }

      .editorial-side,
      .advertiser-side {
        padding: 52px;
      }

      .editorial-side {
        border-right: 1px solid #dce6ea;
      }

      .advertiser-side {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        background: linear-gradient(145deg, #edf7fa, #f8fcfd);
        text-align: center;
      }

      .visual-label {
        display: block;
        margin-bottom: 30px;
        color: var(--blue);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.14em;
      }

      .visual-title {
        width: 82%;
        height: 18px;
        margin-bottom: 12px;
        background: var(--navy);
        border-radius: 2px;
      }

      .visual-title.short {
        width: 55%;
        margin-bottom: 38px;
      }

      .visual-copy {
        width: 92%;
        height: 7px;
        margin-bottom: 10px;
        background: #cad9df;
        border-radius: 99px;
      }

      .visual-copy.medium {
        width: 68%;
      }

      .brand-symbol {
        position: relative;
        display: grid;
        width: 78px;
        height: 78px;
        margin-bottom: 22px;
        place-items: center;
        border: 1px solid #75aec1;
        border-radius: 50%;
      }

      .brand-symbol::before,
      .brand-symbol::after {
        position: absolute;
        background: #75aec1;
        content: "";
      }

      .brand-symbol::before {
        width: 1px;
        height: 110px;
      }

      .brand-symbol::after {
        width: 110px;
        height: 1px;
      }

      .brand-symbol span {
        position: relative;
        z-index: 1;
        width: 10px;
        height: 10px;
        background: #fff;
        border: 2px solid var(--blue);
        border-radius: 50%;
      }

      .advertiser-side strong {
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: 1.25rem;
        line-height: 1.25;
      }

      .visual-result {
        display: grid;
        align-items: center;
        padding: 20px 26px;
        color: #fff;
        background: var(--navy);
        grid-template-columns: 1fr auto 1fr;
        gap: 28px;
        text-align: center;
      }

      .visual-result span {
        color: #9fc5d5;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.13em;
      }

      .visual-result strong {
        font-family: Georgia, serif;
        font-size: 1.25rem;
      }

      .model-benefits {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .model-benefits article {
        padding: 34px 30px;
        border-right: 1px solid var(--line);
      }

      .model-benefits article:first-child {
        padding-left: 0;
      }

      .model-benefits article:last-child {
        padding-right: 0;
        border-right: 0;
      }

      .benefit-number {
        display: block;
        margin-bottom: 24px;
        color: var(--blue);
        font-family: Georgia, serif;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .model-benefits h3 {
        margin-bottom: 12px;
        font-size: 1.35rem;
      }

      .model-benefits p {
        margin: 0;
        color: #586e7c;
        font-size: 0.92rem;
      }

      .model-statement {
        margin-top: 68px;
        text-align: center;
      }

      .model-statement span {
        display: block;
        margin-bottom: 12px;
        color: var(--blue);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.13em;
      }

      .model-statement p {
        margin-bottom: 4px;
        color: #617582;
        font-size: 1rem;
      }

      .model-statement strong {
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: clamp(1.7rem, 3vw, 2.5rem);
        line-height: 1.3;
      }

      /* 05 Proof of Concept */

      .poc {
        background:
          linear-gradient(
            180deg,
            #f7fafb 0%,
            #eef6f8 100%
          );
      }

      .poc-heading {
        display: grid;
        align-items: end;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        margin-bottom: 58px;
      }

      .poc-heading .section-title {
        margin-bottom: 0;
      }

      .poc-intro {
        max-width: 560px;
        margin: 0;
        color: #536a79;
        font-size: 1.08rem;
      }

      .poc-results {
        display: grid;
        margin-bottom: 64px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #c8dce5;
        border-radius: 12px;
        grid-template-columns: 0.7fr 0.7fr 1.6fr;
      }

      .poc-metric,
      .poc-summary {
        padding: 34px;
      }

      .poc-metric {
        border-right: 1px solid #d8e4e9;
        text-align: center;
      }

      .poc-metric span,
      .poc-summary span {
        display: block;
        margin-bottom: 10px;
        color: var(--blue);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .poc-metric strong {
        display: block;
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
      }

      .poc-summary {
        display: flex;
        justify-content: center;
        flex-direction: column;
      }

      .poc-summary p {
        margin: 0;
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: 1.35rem;
        line-height: 1.4;
      }

      .poc-story {
        display: grid;
        align-items: stretch;
        grid-template-columns: 1fr auto 1fr;
        gap: 28px;
      }

      .poc-before,
      .poc-after {
        padding: 38px;
        background: rgb(255 255 255 / 72%);
        border: 1px solid #d5e3e8;
        border-radius: 10px;
      }

      .poc-after {
        background: #fff;
      }

      .poc-label {
        display: block;
        margin-bottom: 12px;
        color: var(--blue);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .poc-story h3 {
        margin-bottom: 24px;
        font-size: 1.55rem;
      }

      .poc-story ul {
        margin: 0;
        padding-left: 1.2rem;
        color: #536a79;
      }

      .poc-story li {
        margin-bottom: 9px;
      }

      .poc-arrow {
        display: grid;
        place-items: center;
        color: var(--blue);
        font-family: Georgia, serif;
        font-size: 2.3rem;
      }

      .poc-conclusion {
        margin-top: 60px;
        text-align: center;
      }

      .poc-conclusion span {
        display: block;
        margin-bottom: 10px;
        color: var(--blue);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .poc-conclusion p {
        margin-bottom: 4px;
        color: #617582;
      }

      .poc-conclusion strong {
        color: var(--navy);
        font-family: Georgia, serif;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
      }

      .hero-metrics-source {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 12px;
        color: var(--blue);
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: 0.03em;
        text-decoration: none;
      }

      .hero-metrics-source span {
        transition: transform 0.2s ease;
      }

      .hero-metrics-source:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .hero-metrics-source:hover span {
        transform: translateX(3px);
      }

      .hero-metrics-source:focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 4px;
      }

/* 06 Collaboration */

.collaboration-section {
  background: #fff;
}

.collaboration-heading {
  display: grid;
  align-items: end;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 80px;
  margin-bottom: 64px;
}

.collaboration-heading .section-title {
  margin-bottom: 0;
}

.collaboration-intro {
  max-width: 560px;
  margin: 0;
  color: #536a79;
  font-size: 1.08rem;
}

.aamp-relationship {
  display: grid;
  align-items: stretch;
  grid-template-columns: 1fr auto 1fr;
  gap: 28px;
}

.aamp-side,
.integrity-side {
  padding: 42px;
  border: 1px solid var(--line);
  border-radius: 12px;
}

.aamp-side {
  background: #f7fafb;
}

.integrity-side {
  background: #edf7fb;
}

.relationship-label {
  display: block;
  margin-bottom: 16px;
  color: var(--blue);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.aamp-relationship h3 {
  margin-bottom: 20px;
  font-size: 1.8rem;
}

.aamp-relationship p {
  color: #536a79;
}

.relationship-question {
