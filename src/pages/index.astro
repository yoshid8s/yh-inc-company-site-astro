  color: var(--blue);
  font-family: Georgia, serif;
  font-size: 2.4rem;
}

.collaboration-result {
  margin-top: 64px;
  padding: 48px;
  color: #fff;
  background:
    radial-gradient(
      circle at 75% 40%,
