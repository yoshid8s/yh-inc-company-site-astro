}

.exploration-grid article {
  padding: 34px 28px;
  border-right: 1px solid var(--line);
}

.exploration-grid article:first-child {
  padding-left: 0;
}

.exploration-grid article:last-child {
  padding-right: 0;
  border-right: 0;
}

.exploration-grid article > span {
  display: block;
  margin-bottom: 20px;
  color: var(--blue);
  font-family: Georgia, serif;
  font-size: 0.8rem;
  font-weight: 700;
}

.exploration-grid h3 {
  margin-bottom: 12px;
  font-size: 1.3rem;
}

.exploration-grid p {
  margin: 0;
  color: #586e7c;
  font-size: 0.92rem;
}

.collaboration-note {
  margin-top: 58px;
  text-align: center;
}

.collaboration-note p {
  margin-bottom: 5px;
  color: #667985;
}

.collaboration-note strong {
  color: var(--navy);
  font-family: Georgia, serif;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  line-height: 1.35;
}

.research-question {
  margin-top: 72px;
  padding-top: 38px;
  border-top: 1px solid var(--line);
}

.research-question > span {
  display: block;
  margin-bottom: 18px;
  color: var(--blue);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.research-question p {
  max-width: 820px;
  margin: 0;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2rem, 4vw, 3.6rem);
  font-weight: 700;
  line-height: 1.12;
}

.research-question strong {
  display: block;
  max-width: 720px;
  margin-top: 26px;
  color: #536a79;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.7;
}

.collaboration-types {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin: 34px 0 36px;
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 18%);
  border-radius: 8px;
  background: rgb(255 255 255 / 18%);
}

.collaboration-types span {
  display: flex;
  align-items: center;
  min-height: 58px;
  padding: 14px 18px;
  background: rgb(11 49 80 / 96%);
  color: rgb(255 255 255 / 82%);
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.04em;
}

/* 07 Leadership */

.leadership-section {
  background: #f7fafb;
}

.leadership-heading {
  display: grid;
  align-items: end;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 80px;
  margin-bottom: 64px;
}

.leadership-heading .section-title {
  margin-bottom: 0;
}

.leadership-intro {
  max-width: 520px;
  margin: 0;
  color: #536a79;
  font-size: 1.08rem;
}

.leadership-profile {
  display: grid;
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 12px;
  grid-template-columns: 0.75fr 1.25fr;
}

.profile-identity {
  padding: 0;
  overflow: hidden;
  background:
    linear-gradient(
      145deg,
      #edf7fa 0%,
      #f8fcfd 100%
    );
  border-right: 1px solid var(--line);
}

.profile-photo {
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background: #dce8ed;
}

.profile-photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
}

.profile-identity-content {
  padding: 38px 46px 42px;
}

.profile-label,
.profile-origin > span {
  display: block;
  color: var(--blue);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.profile-label {
  margin-bottom: 18px;
}

.profile-identity h3 {
  margin-bottom: 8px;
  font-size: clamp(2rem, 4vw, 3rem);
}

.profile-role {
  margin-bottom: 32px;
  color: #536a79;
  font-weight: 700;
}

.profile-origin {
  padding-top: 26px;
  border-top: 1px solid rgb(11 49 80 / 12%);
}

.profile-origin > span {
  margin-bottom: 7px;
}

.profile-origin > strong {
  display: block;
  color: var(--navy);
  font-family: Georgia, serif;
  font-size: 1.3rem;
}

.profile-story {
  padding: 46px 52px;
}

.profile-story p {
  color: #536a79;
}

.profile-story p:last-child {
  margin-bottom: 0;
}

.profile-story .profile-lead {
  color: var(--navy);
  font-family: Georgia, serif;
  font-size: 1.35rem;
  line-height: 1.45;
}

.profile-story strong {
  color: var(--navy);
}

.profile-link {
  position: relative;
  display: block;
  margin-top: 22px;
  padding-top: 20px;
  padding-right: 28px;
  border-top: 1px solid var(--line);
  color: inherit;
  text-decoration: none;
}

.profile-link > span:first-child {
  display: block;
  margin-bottom: 8px;
  color: var(--blue);
  font-size: 0.62rem;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.14em;
}

.profile-link strong {
  display: block;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 0.98rem;
  font-weight: 700;
  line-height: 1.35;
}

.profile-link-arrow {
  position: absolute;
  right: 0;
  bottom: 1px;
  color: var(--blue);
  font-size: 0.9rem;
