  text-align: center;
}

.collaboration-result > span {
  display: block;
  margin-bottom: 18px;
  color: #9fc5d5;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.collaboration-result h3 {
  margin-bottom: 22px;
  color: #fff;
  font-size: clamp(1.6rem, 3vw, 2.5rem);
}

.collaboration-result h3 span {
  padding-inline: 0.22em;
  color: #78b7cd;
  font-weight: 400;
}

.collaboration-result p {
  max-width: 820px;
  margin: 0 auto;
  color: #d9eaf1;
}

.exploration-grid {
  display: grid;
  margin-top: 64px;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--line);
